{
  "name": "toscan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch src/server/index.ts",
    "dev:web": "vite",
    "check": "tsc --noEmit",
    "test": "node --test src/server/app.test.ts src/analysis/*.test.ts",
    "analysis:fixture": "node --env-file-if-exists=.env src/analysis/run-fixture.ts",
    "build": "npm run check && vite build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
