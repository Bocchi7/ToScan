# DeepSeek through the OpenAI SDK. This is a template; copy it to .env.
TOSCAN_MODEL_PROVIDER=deepseek
TOSCAN_MODEL_BASE_URL=https://api.deepseek.com
# Or set DEEPSEEK_API_KEY; TOSCAN_MODEL_API_KEY takes precedence when non-empty.
TOSCAN_MODEL_API_KEY=
TOSCAN_MODEL_NAME=deepseek-flash
TOSCAN_MODEL_THINKING=enabled
# Effort: minimal, low, medium, high, xhigh, max. Disable thinking via THINKING above.
TOSCAN_MODEL_REASONING_EFFORT=high
# Only deepseek / deepseek-flash is supported; other combinations fail before requests.
# Optional timeout override; default is in config/default.json.
# TOSCAN_MODEL_TIMEOUT_MS=60000
# Optional output cap; omit or leave blank to use the provider's default limit.
TOSCAN_MODEL_MAX_COMPLETION_TOKENS=
