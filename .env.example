# Compatible Chat Completions API root, including its /v1 path if required.
# The model must support response_format=json_object and max_completion_tokens.
TOSCAN_MODEL_BASE_URL=https://api.openai.com/v1
TOSCAN_MODEL_API_KEY=
TOSCAN_MODEL_NAME=
# Optional overrides; defaults are in config/default.json.
# TOSCAN_MODEL_TIMEOUT_MS=60000
# TOSCAN_MODEL_MAX_COMPLETION_TOKENS=4096
